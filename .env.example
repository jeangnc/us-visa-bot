# US Visa Bot Configuration
# Copy this file to .env and fill in your actual values

# Your credentials for https://ais.usvisa-info.com/
EMAIL=your.email@example.com
PASSWORD=your_password_here

# Country code - the part after "en-" in the site's URL
# Examples: 'br' for Brazil, 'fr' for France, 'ca' for Canada
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv
COUNTRY_CODE=ca

# Schedule ID - found in the URL when trying to reschedule manually
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv/schedule/{SCHEDULE_ID}/continue_actions
SCHEDULE_ID=12345678

# Facility ID(s) - found in network calls when selecting a new date or inspecting the selector
# One ID, or several separated by commas to watch more than one consulate
# Examples: Paris is 44; in Canada, 89,92,94 is Calgary, Ottawa and Toronto
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv/schedule/{SCHEDULE_ID}/appointment/address/{FACILITY_ID}
FACILITY_ID=44

# Seconds between rounds of checks: a number, or a range for a random gap each time
# Optional, defaults to 180-300. Anything under 60 is raised to 60 - checking every
# few seconds gets accounts blocked.
REFRESH_DELAY=180-300

# Most requests the bot may send in any rolling 24 hours (optional, defaults to 500).
# When it's used up the bot waits instead of risking a block.
DAILY_REQUEST_CAP=500