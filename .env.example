# US Visa Bot Configuration
# Copy this file to .env and fill in your actual values

# Your credentials for https://ais.usvisa-info.com/
EMAIL=your.email@example.com
PASSWORD=your_password_here

# Country code - found in the URL after "en-"
# Examples: 'br' for Brazil, 'fr' for France, 'mx' for Mexico
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv
COUNTRY_CODE=fr

# Schedule ID - found in the URL when trying to reschedule manually
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv/schedule/{SCHEDULE_ID}/continue_actions
SCHEDULE_ID=12345678

# Facility ID - the consulate; see "Finding Your Facility IDs" in the README
# Examples: Paris is 44, Sao Paulo is 56
FACILITY_ID=44

# ASC Facility ID (optional) - required in countries with a separate biometrics appointment
# (ASC/CASV, e.g. Brazil, Mexico, Colombia). Without it the site drops your existing ASC appointment.
# Example: Sao Paulo ASC Unidade Vila Mariana is 60
# ASC_FACILITY_ID=60

# Max date (optional, YYYY-MM-DD) - never book after this date; the --max flag overrides it.
# After each booking it steps down to the end of the previous month (see README).
# MAX_DATE=2026-11-30

# Refresh delay in seconds between checks (optional, defaults to 3)
# Short delays get the account soft-banned (empty date lists for hours) sooner; see README "Rate Limiting"
REFRESH_DELAY=3
